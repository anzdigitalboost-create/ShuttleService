# this storefront frontend — environment variables.
# Production needs none: vercel.json proxies /api/* to the live
# bookaride.co.nz API, so bookings land in the shared database.
# Local dev: copy to .env.local to hit the live API directly.
VITE_BACKEND_URL=https://www.bookaride.co.nz
VITE_API_URL=https://www.bookaride.co.nz/api
